# Copy to demo/.env and fill in. .env is gitignored — keep it that way.
#
# SBP and SERVICE bypass every RLS policy in migrations/07 and 08.
# They belong in this file and nowhere else: never in web/, never in an
# Edge Function that serves user requests, never in the browser.

# --- Supabase -------------------------------------------------------------
# Management (personal access) token: Dashboard > Account > Access Tokens.
# Used by tools/sql.js and tools/deploy-fn.js.
SBP=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Project ref — the subdomain of your project URL.
REF=xxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# anon / publishable key. This one is PUBLIC by design: it ends up in
# web/js/config.js and is served to every visitor. RLS is what protects the
# data, not this key.
ANON=eyJhbGciOi...

# service_role key. Bypasses RLS completely. Only used to create the demo
# auth accounts (see README, step 10).
SERVICE=eyJhbGciOi...

# --- Vercel ---------------------------------------------------------------
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT=ipm-crm-demo
